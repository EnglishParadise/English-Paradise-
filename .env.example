# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=replace_with_meta_access_token
PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
VERIFY_TOKEN=choose_a_long_random_webhook_verification_token
GRAPH_API_VERSION=v23.0

# OpenAI (required for AI tutor and voice transcription)
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Public URLs to your actual PDF notes (optional)
GRAMMAR_PDF_URL=
VOCABULARY_PDF_URL=
INTERMEDIATE_PDF_URL=

# Protects the daily lesson admin endpoint
ADMIN_TOKEN=replace_with_a_long_random_admin_token

PORT=3000
